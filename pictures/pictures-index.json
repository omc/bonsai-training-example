{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "knn": true,
    "analysis": {
      "filter": {
        "english_stop": {
          "type": "stop",
          "stopwords": "_english_"
        },
        "english_stem": {
          "type": "stemmer",
          "language": "english"
        },
        "english_stem_light": {
          "type": "stemmer",
          "language": "possessive_english"
        }
      },
      "analyzer": {
        "analyze_english": {
          "type": "custom",
          "tokenizer": "standard",
          "char_filter": ["html_strip"],
          "filter": ["lowercase", "english_stop", "english_stem"]
        },
        "analyze_english_precise": {
          "type": "custom",
          "tokenizer": "standard",
          "char_filter": ["html_strip"],
          "filter": ["lowercase", "english_stem_light"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "keyword"
      },
      "path": {
        "type": "keyword"
      },
      "img": {
        "type": "binary"
      },
      "emb": {
        "type": "knn_vector",
        "dimension": 1152,
        "method": {
          "name": "hnsw",
          "parameters": {
            "ef_construction": 256,
            "m": 16
          }
        }
      },
      "width": {
        "type": "short"
      },
      "height": {
        "type": "short"
      }
    }
  }
}
