<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>bonsai &mdash; <%= query %></title>
  <link rel="shortcut icon" type="image/x-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde604e0c417ffb_Favicon.png" />
  <link rel="apple-touch-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde602edf417ffc_Webclip.png" />
  <link href="/css/fonts.css" rel="stylesheet">
  <link href="/css/results.css" rel="stylesheet">
  <% if (config.autocomplete) { %><link href="/css/autocomplete.css" rel="stylesheet"><% } %>
</head>
<body>
  <div class="bg-wash" aria-hidden="true"></div>

  <header class="app-header">
    <div class="header-inner">
      <a href="/"><img src="/img/logo.svg" width="100" height="28"></a>
      <form class="search" action="/<%= dataset %>/search" method="get" autocomplete="off" role="search">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="M20 20l-3.5-3.5"/>
        </svg>
        <input name="q" type="text" aria-label="Search" value="<%= query %>" placeholder="Search<%= (typeof indexCount !== 'undefined' && indexCount) ? ' ' + indexCount.toLocaleString() : '' %> <%= config.label %> entries..."<% if (config.autocomplete) { %> data-autocomplete="/<%= dataset %>/autocomplete" data-asset-base="/<%= dataset %>/asset"<% } %> />
        <% if (config.permissionPresets) { %>
        <select name="role" class="role-select" aria-label="Permission role" onchange="this.form.submit()">
          <option value="">No permissions filter</option>
          <optgroup label="Employees">
            <% config.permissionPresets.filter(function(p) { return p.value.startsWith('employee-'); }).forEach(function(p) { %>
            <option value="<%= p.value %>"<%= (typeof role !== 'undefined' && role === p.value) ? ' selected' : '' %>><%= p.label %></option>
            <% }); %>
          </optgroup>
          <optgroup label="Customers">
            <% config.permissionPresets.filter(function(p) { return p.value.startsWith('customer-'); }).forEach(function(p) { %>
            <option value="<%= p.value %>"<%= (typeof role !== 'undefined' && role === p.value) ? ' selected' : '' %>><%= p.label %></option>
            <% }); %>
          </optgroup>
          <% config.permissionPresets.filter(function(p) { return !p.value.startsWith('employee-') && !p.value.startsWith('customer-'); }).forEach(function(p) { %>
          <option value="<%= p.value %>"<%= (typeof role !== 'undefined' && role === p.value) ? ' selected' : '' %>><%= p.label %></option>
          <% }); %>
        </select>
        <% } %>
      </form>
    </div>
  </header>

  <%
    var hits = results.body.hits.hits || [];
    var total = results.body.hits.total;
    var totalCount = (typeof total === 'object') ? total.value : total;
    var took = results.body.took;
    var aggs = results.body.aggregations || {};
    var f = filters || {};
    function isChecked(param, val) {
      return f[param] && f[param].indexOf(String(val)) !== -1;
    }
  %>

  <% var isSimilar = (typeof mode !== 'undefined' && mode === 'similar'); %>
  <div class="count-row">
    <% if (isSimilar) { %>
    <strong><%= totalCount.toLocaleString() %></strong> results <span class="meta-sep">&middot;</span> <%= (took / 1000).toFixed(2) %> seconds <span class="meta-sep">&middot;</span> similar to <em><%= similarLabel %></em> <span class="meta-sep">&middot;</span> <a href="/<%= dataset %>">new search</a>
    <% } else { %>
    <strong><%= totalCount.toLocaleString() %></strong> results <span class="meta-sep">&middot;</span> <%= (took / 1000).toFixed(2) %> seconds <span class="meta-sep">&middot;</span> for <em>&ldquo;<%= query %>&rdquo;</em>
    <% } %>
  </div>

  <%
    var isGrid = config.display.layout === 'grid';
    // No facets on similarity results: they come from a plain kNN query.
    var hasFilters = !isSimilar && config.aggregations && config.aggregations.length;
  %>
  <div class="layout<%= (isGrid && !hasFilters) ? ' layout-grid' : '' %><%= config.display.justified ? ' layout-wide' : '' %>">
    <% if (hasFilters) { %>
    <%
      var clearParams = new URLSearchParams({ q: query });
      if (typeof role !== 'undefined' && role) clearParams.set('role', role);
    %>
    <%- include('_filters', {
      config: config, aggs: aggs, filters: f,
      action: '/' + dataset + '/search',
      hidden: { q: query, role: (typeof role !== 'undefined' ? role : null) },
      clearHref: '/' + dataset + '/search?' + clearParams.toString(),
    }) %>
    <% } %>

    <main class="results">
      <% if (hits.length === 0) { %>
      <p>No results found for &ldquo;<%= query %>&rdquo;.</p>
      <% } %>

      <% if (isGrid) { %>
      <div class="picture-grid<%= config.display.justified ? ' justified' : '' %>">
        <% hits.forEach(function(hit) {
          var src = hit._source;
        %>
        <%- include('_result-tile', { hit: hit, src: src, config: config, dataset: dataset, sourceId: (typeof similarId !== 'undefined' ? similarId : null) }) %>
        <% }); %>
      </div>
      <% } else { %>
      <% hits.forEach(function(hit) {
        var src = hit._source;
        var img = config.display.image ? (config.display.image(src) || config.display.imageFallback) : null;
        var snippet = config.display.snippet ? config.display.snippet(src) : null;
        var link = config.display.linkTemplate(src);
        var title = config.display.titleValue ? config.display.titleValue(src) : src[config.display.titleField];
      %>
      <% if (config.display.layout === 'rows') { %>
      <%- include('_result-row', { hit: hit, src: src, title: title, link: link, config: config }) %>
      <% } else { %>
      <%- include('_result-card', { hit: hit, src: src, title: title, link: link, img: img, snippet: snippet, config: config }) %>
      <% } %>
      <% }); %>
      <% } %>

      <%
        // Hybrid queries can only page within pagination_depth.
        var pageable = config.query.paginationDepth ? Math.min(totalCount, config.query.paginationDepth) : totalCount;
        var totalPages = Math.ceil(pageable / perPage);
        if (totalPages > 1) {
          var baseParams = new URLSearchParams();
          if (isSimilar) {
            baseParams.set('id', similarId);
          } else {
            baseParams.set('q', query);
            if (typeof role !== 'undefined' && role) baseParams.set('role', role);
            var fKeys = Object.keys(f);
            fKeys.forEach(function(key) {
              [].concat(f[key]).forEach(function(val) {
                baseParams.append(key, val);
              });
            });
          }
          var pagePath = isSimilar ? '/similar?' : '/search?';
          function pageUrl(p) {
            var ps = new URLSearchParams(baseParams);
            if (p > 1) ps.set('page', p);
            return '/' + dataset + pagePath + ps.toString();
          }

          var windowSize = 7;
          var startPage = Math.max(1, page - Math.floor(windowSize / 2));
          var endPage = Math.min(totalPages, startPage + windowSize - 1);
          if (endPage - startPage + 1 < windowSize) {
            startPage = Math.max(1, endPage - windowSize + 1);
          }
      %>
      <nav class="pagination" aria-label="Search results pages">
        <% if (page > 1) { %>
        <a class="page-arrow" href="<%= pageUrl(page - 1) %>">&laquo; Prev</a>
        <% } %>
        <% if (startPage > 1) { %>
        <a class="page-num" href="<%= pageUrl(1) %>">1</a>
        <% if (startPage > 2) { %><span class="page-num">&hellip;</span><% } %>
        <% } %>
        <% for (var p = startPage; p <= endPage; p++) { %>
        <a class="page-num<%= p === page ? ' active' : '' %>" href="<%= pageUrl(p) %>"><%= p %></a>
        <% } %>
        <% if (endPage < totalPages) { %>
        <% if (endPage < totalPages - 1) { %><span class="page-num">&hellip;</span><% } %>
        <a class="page-num" href="<%= pageUrl(totalPages) %>"><%= totalPages %></a>
        <% } %>
        <% if (page < totalPages) { %>
        <a class="page-arrow" href="<%= pageUrl(page + 1) %>">Next &raquo;</a>
        <% } %>
      </nav>
      <% } %>
    </main>
  </div>

  <footer class="app-footer">
    <div class="footer-row">
      <div>&copy; 2026 Bonsai</div>
      <div class="links">
        <a href="https://bonsai.io/">About</a>
        <a href="https://bonsai.io/privacy">Privacy</a>
        <a href="https://bonsai.io/terms">Terms</a>
      </div>
    </div>
  </footer>

  <% if (config.autocomplete) { %><script src="/js/autocomplete.js" defer></script><% } %>
</body>
</html>
