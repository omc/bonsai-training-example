<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>bonsai &mdash; <%= query %></title>
  <link rel="shortcut icon" type="image/x-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde604e0c417ffb_Favicon.png" />
  <link rel="apple-touch-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde602edf417ffc_Webclip.png" />
  <link href="/css/fonts.css" rel="stylesheet">
  <link href="/css/results.css" rel="stylesheet">
</head>
<body>
  <div class="bg-wash" aria-hidden="true"></div>

  <header class="app-header">
    <div class="header-inner">
      <a href="/"><img src="/img/logo.svg" width="100" height="28"></a>
      <form class="search" action="/search" method="get" autocomplete="off" role="search">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="M20 20l-3.5-3.5"/>
        </svg>
        <input name="q" type="text" aria-label="Search" value="<%= query %>" />
      </form>
    </div>
  </header>

  <%
    var hits = results.body.hits.hits || [];
    var total = results.body.hits.total;
    var totalCount = (typeof total === 'object') ? total.value : total;
    var took = results.body.took;
    var aggs = results.body.aggregations || {};
    var f = filters || {};
    function isChecked(param, val) {
      return f[param] && f[param].indexOf(String(val)) !== -1;
    }
  %>

  <div class="count-row">
    <strong><%= totalCount.toLocaleString() %></strong> results <span class="meta-sep">&middot;</span> <%= (took / 1000).toFixed(2) %> seconds <span class="meta-sep">&middot;</span> for <em>&ldquo;<%= query %>&rdquo;</em>
  </div>

  <div class="layout">
    <button class="filters-toggle" type="button" aria-expanded="false" aria-controls="filters-panel">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="20" y2="12"/><line x1="12" y1="18" x2="20" y2="18"/></svg>
      Filters
    </button>
    <aside class="filters" id="filters-panel">
      <h2>Filters</h2>

      <% if (aggs.subjects && aggs.subjects.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Subject
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.subjects.buckets.forEach(function(b) { %>
          <label class="filter-row"><input type="checkbox" name="subjects" value="<%= b.key %>"<%= isChecked('subjects', b.key) ? ' checked' : '' %> /> <%= b.key %> <span class="count"><%= b.doc_count %></span></label>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (aggs.authors && aggs.authors.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Author
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.authors.buckets.forEach(function(b) { %>
          <label class="filter-row"><input type="checkbox" name="authors" value="<%= b.key %>"<%= isChecked('authors', b.key) ? ' checked' : '' %> /> <%= b.key %> <span class="count"><%= b.doc_count %></span></label>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (aggs.bookshelves && aggs.bookshelves.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Bookshelf
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.bookshelves.buckets.forEach(function(b) { %>
          <label class="filter-row"><input type="checkbox" name="bookshelves" value="<%= b.key %>"<%= isChecked('bookshelves', b.key) ? ' checked' : '' %> /> <%= b.key %> <span class="count"><%= b.doc_count %></span></label>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (aggs.languages && aggs.languages.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Language
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.languages.buckets.forEach(function(b) { %>
          <label class="filter-row"><input type="checkbox" name="languages" value="<%= b.key %>"<%= isChecked('languages', b.key) ? ' checked' : '' %> /> <%= b.key %> <span class="count"><%= b.doc_count %></span></label>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (aggs.media_type && aggs.media_type.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Media Type
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.media_type.buckets.forEach(function(b) { %>
          <label class="filter-row"><input type="checkbox" name="media_type" value="<%= b.key %>"<%= isChecked('media_type', b.key) ? ' checked' : '' %> /> <%= b.key %> <span class="count"><%= b.doc_count %></span></label>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (aggs.copyright && aggs.copyright.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Copyright
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.copyright.buckets.forEach(function(b) { %>
          <label class="filter-row"><input type="checkbox" name="copyright" value="<%= b.key_as_string %>"<%= isChecked('copyright', b.key_as_string) ? ' checked' : '' %> /> <%= b.key_as_string === 'true' ? 'Copyrighted' : 'Public Domain' %> <span class="count"><%= b.doc_count %></span></label>
          <% }); %>
        </div>
      </div>
      <% } %>

      <% if (aggs.popularity && aggs.popularity.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Popularity
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.popularity.buckets.forEach(function(b) { if (b.doc_count > 0) { %>
          <label class="filter-row"><input type="checkbox" name="popularity" value="<%= b.key %>"<%= isChecked('popularity', b.key) ? ' checked' : '' %> /> <%= b.key.replace('_', ' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); }) %> <span class="count"><%= b.doc_count %></span></label>
          <% } }); %>
        </div>
      </div>
      <% } %>

      <% if (aggs.author_era && aggs.author_era.buckets.length) { %>
      <div class="filter-group">
        <h3>
          Author Era
          <svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </h3>
        <div class="filter-body">
          <% aggs.author_era.buckets.forEach(function(b) { if (b.doc_count > 0) { %>
          <label class="filter-row"><input type="checkbox" name="author_era" value="<%= b.key %>"<%= isChecked('author_era', b.key) ? ' checked' : '' %> /> <%= b.key %>s <span class="count"><%= b.doc_count %></span></label>
          <% } }); %>
        </div>
      </div>
      <% } %>

      <a class="clear-btn" href="/search?q=<%= encodeURIComponent(query) %>">Clear all filters</a>
    </aside>

    <main class="results">
      <% if (hits.length === 0) { %>
      <p>No results found for &ldquo;<%= query %>&rdquo;.</p>
      <% } %>

      <% hits.forEach(function(hit) {
        var src = hit._source;
        var authors = [].concat(src.author_names || []);
        var subjects = [].concat(src.subjects || []);
        var languages = [].concat(src.languages || []);
        var summaries = [].concat(src.summaries || []);
        var snippet = summaries.length ? summaries[0] : '';
        var img = src.formats && src.formats['image/jpeg'] || '/img/book.svg';
        if (snippet.length > 300) snippet = snippet.substring(0, 300) + '...';
      %>
      <article class="result">
        <div class="thumb" aria-hidden="true">
          <img src="<%- img %>">
        </div>
        <div>
          <div class="meta-row">
            <% if (authors.length) { %>
            <span><%= authors.join(', ') %></span>
            <span class="meta-sep">&middot;</span>
            <% } %>
            <% if (languages.length) { %>
            <span><%= languages.join(', ') %></span>
            <span class="meta-sep">&middot;</span>
            <% } %>
            <% if (src.download_count != null) { %>
            <span><%= src.download_count.toLocaleString() %> downloads</span>
            <% } %>
          </div>
          <h3><a href="https://www.gutenberg.org/ebooks/<%= src.gutenberg_id %>"><%= src.title %></a></h3>
          <% if (snippet) { %>
          <p class="snippet"><%= snippet %></p>
          <% } %>
          <div class="result-tags">
            <% if (src.media_type) { %><span class="tag"><%= src.media_type %></span><% } %>
            <% if (src.copyright === false) { %><span class="tag">Public Domain</span><% } %>
            <% subjects.slice(0, 3).forEach(function(s) { %>
            <span class="tag"><%= s %></span>
            <% }); %>
          </div>
        </div>
      </article>
      <% }); %>

      <%
        var totalPages = Math.ceil(totalCount / perPage);
        if (totalPages > 1) {
          // build base query string preserving q + filters (not page)
          var baseParams = new URLSearchParams();
          baseParams.set('q', query);
          var fKeys = Object.keys(f);
          fKeys.forEach(function(key) {
            [].concat(f[key]).forEach(function(val) {
              baseParams.append(key, val);
            });
          });
          function pageUrl(p) {
            var ps = new URLSearchParams(baseParams);
            if (p > 1) ps.set('page', p);
            return '/search?' + ps.toString();
          }

          // compute visible page window (max 7 pages shown)
          var windowSize = 7;
          var startPage = Math.max(1, page - Math.floor(windowSize / 2));
          var endPage = Math.min(totalPages, startPage + windowSize - 1);
          if (endPage - startPage + 1 < windowSize) {
            startPage = Math.max(1, endPage - windowSize + 1);
          }
      %>
      <nav class="pagination" aria-label="Search results pages">
        <% if (page > 1) { %>
        <a class="page-arrow" href="<%= pageUrl(page - 1) %>">&laquo; Prev</a>
        <% } %>
        <% if (startPage > 1) { %>
        <a class="page-num" href="<%= pageUrl(1) %>">1</a>
        <% if (startPage > 2) { %><span class="page-num">&hellip;</span><% } %>
        <% } %>
        <% for (var p = startPage; p <= endPage; p++) { %>
        <a class="page-num<%= p === page ? ' active' : '' %>" href="<%= pageUrl(p) %>"><%= p %></a>
        <% } %>
        <% if (endPage < totalPages) { %>
        <% if (endPage < totalPages - 1) { %><span class="page-num">&hellip;</span><% } %>
        <a class="page-num" href="<%= pageUrl(totalPages) %>"><%= totalPages %></a>
        <% } %>
        <% if (page < totalPages) { %>
        <a class="page-arrow" href="<%= pageUrl(page + 1) %>">Next &raquo;</a>
        <% } %>
      </nav>
      <% } %>
    </main>
  </div>

  <footer class="app-footer">
    <div class="footer-row">
      <div>&copy; 2026 Bonsai</div>
      <div class="links">
        <a href="https://bonsai.io/">About</a>
        <a href="https://bonsai.io/privacy">Privacy</a>
        <a href="https://bonsai.io/terms">Terms</a>
      </div>
    </div>
  </footer>

  <script>
    document.querySelectorAll('.filter-group h3').forEach(function (h) {
      h.addEventListener('click', function () {
        h.parentElement.classList.toggle('collapsed');
      });
    });

    var toggle = document.querySelector('.filters-toggle');
    var panel = document.getElementById('filters-panel');
    if (toggle && panel) {
      toggle.addEventListener('click', function () {
        var open = panel.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
    }

    document.querySelectorAll('.filters input[type="checkbox"]').forEach(function (cb) {
      cb.addEventListener('change', function () {
        var params = new URLSearchParams();
        params.set('q', '<%= query.replace(/'/g, "\\'") %>');
        document.querySelectorAll('.filters input[type="checkbox"]:checked').forEach(function (checked) {
          params.append(checked.name, checked.value);
        });
        window.location.href = '/search?' + params.toString();
      });
    });
  </script>
</body>
</html>
