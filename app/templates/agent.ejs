<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bonsai Search &mdash; Books Agent</title>
  <link rel="shortcut icon" type="image/x-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde604e0c417ffb_Favicon.png" />
  <link rel="apple-touch-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde602edf417ffc_Webclip.png" />
  <link href="/css/fonts.css" rel="stylesheet">
  <link href="/css/agent.css" rel="stylesheet">
</head>
<body>
  <div class="bg-wash" aria-hidden="true"></div>

  <header class="app-header">
    <div class="header-inner">
      <a href="/"><img src="/img/logo.svg" width="100" height="28"></a>
      <form class="search" id="agent-form" autocomplete="off" role="search">
        <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <path d="M20 20l-3.5-3.5"/>
        </svg>
        <input name="q" type="text" aria-label="Search" placeholder="Ask the Books Agent..." value="<%= query %>" />
      </form>
      <a href="/books/" class="back-link">Standard Search</a>
    </div>
  </header>

  <div class="agent-container">
    <div id="progress" class="progress-area" style="display:none;">
      <div class="progress-header">
        <div class="spinner"></div>
        <span id="progress-text">Searching...</span>
      </div>
      <div id="progress-log" class="progress-log"></div>
    </div>

    <div id="error" class="error-area" style="display:none;"></div>

    <div id="results-layout" class="layout" style="display:none;">
      <aside id="workflow" class="workflow-sidebar"></aside>
      <main id="results" class="results"></main>
    </div>

    <div id="landing" class="landing">
      <p class="landing-text">Ask a complex research question and the agent will iteratively search, read, and rank books to find the best results.</p>
      <div class="landing-examples">
        <button type="button" class="example-btn" data-query="Books about time travel written by British authors">Time travel by British authors</button>
        <button type="button" class="example-btn" data-query="Gothic horror novels set in castles">Gothic horror in castles</button>
        <button type="button" class="example-btn" data-query="Philosophy books about ethics and morality written before 1900">Pre-1900 ethics philosophy</button>
      </div>
    </div>
  </div>

  <footer class="app-footer">
    <div class="footer-row">
      <div>&copy; 2026 Bonsai</div>
      <div class="links">
        <a href="https://bonsai.io/">About</a>
        <a href="https://bonsai.io/privacy">Privacy</a>
        <a href="https://bonsai.io/terms">Terms</a>
      </div>
    </div>
  </footer>

  <script>
    var form = document.getElementById('agent-form');
    var input = form.querySelector('input[name="q"]');
    var progressArea = document.getElementById('progress');
    var progressText = document.getElementById('progress-text');
    var progressLog = document.getElementById('progress-log');
    var errorArea = document.getElementById('error');
    var resultsLayout = document.getElementById('results-layout');
    var resultsArea = document.getElementById('results');
    var workflowSidebar = document.getElementById('workflow');
    var landing = document.getElementById('landing');
    var currentSource = null;
    var toolHistory = []; // [{turn, calls: [{name, args}]}]

    function reset() {
      if (currentSource) { currentSource.close(); currentSource = null; }
      progressArea.style.display = 'none';
      errorArea.style.display = 'none';
      resultsLayout.style.display = 'none';
      resultsArea.innerHTML = '';
      workflowSidebar.innerHTML = '';
      progressLog.innerHTML = '';
      errorArea.textContent = '';
      toolHistory = [];
    }

    function runQuery(q) {
      if (!q.trim()) return;
      reset();
      landing.style.display = 'none';
      progressArea.style.display = 'block';
      progressText.textContent = 'Starting agent...';
      input.value = q;

      var startTime = Date.now();
      var url = '/books/agent/stream?q=' + encodeURIComponent(q);
      var source = new EventSource(url);
      currentSource = source;

      source.addEventListener('progress', function(e) {
        var data = JSON.parse(e.data);
        if (data.status === 'thinking') {
          progressText.textContent = 'Turn ' + data.turn + '/' + data.maxTurns + ' — thinking...';
        } else if (data.status === 'tools') {
          progressText.textContent = 'Turn ' + data.turn + '/' + data.maxTurns + ' — calling tools...';
          var calls = data.toolCalls || data.tools.map(function(n) { return {name: n}; });
          toolHistory.push({ turn: data.turn, calls: calls });
          calls.forEach(function(tc) {
            var entry = document.createElement('div');
            entry.className = 'log-entry';
            entry.textContent = 'Turn ' + data.turn + ': ' + formatToolLabel(tc);
            progressLog.appendChild(entry);
          });
        }
      });

      source.addEventListener('tool_results', function(e) {
        var data = JSON.parse(e.data);
        // Merge meta into the matching toolHistory entry
        for (var i = toolHistory.length - 1; i >= 0; i--) {
          if (toolHistory[i].turn === data.turn) {
            data.calls.forEach(function(c, j) {
              if (toolHistory[i].calls[j]) {
                toolHistory[i].calls[j].meta = c.meta;
              }
            });
            break;
          }
        }
      });

      source.addEventListener('results', function(e) {
        var data = JSON.parse(e.data);
        source.close();
        currentSource = null;
        progressArea.style.display = 'none';
        var elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
        renderWorkflow(data.ids);
        renderResults(data.books, elapsed);
        resultsLayout.style.display = 'grid';
      });

      source.addEventListener('error_event', function(e) {
        var data = JSON.parse(e.data);
        source.close();
        currentSource = null;
        progressArea.style.display = 'none';
        errorArea.style.display = 'block';
        errorArea.textContent = data.message || 'An error occurred.';
      });

      source.onerror = function() {
        if (source.readyState === EventSource.CLOSED) return;
        source.close();
        currentSource = null;
        progressArea.style.display = 'none';
        errorArea.style.display = 'block';
        errorArea.textContent = 'Connection lost. Please try again.';
      };
    }

    function esc(s) {
      var d = document.createElement('div');
      d.textContent = s;
      return d.innerHTML;
    }

    var TOOL_ICONS = {
      search: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>',
      text_search: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M4 12h10"/><path d="M4 18h6"/><circle cx="19" cy="17" r="3"/><path d="M22 22l-1.5-1.5"/></svg>',
      read: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
      report_helpful_ids: '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>'
    };

    function formatToolLabel(tc) {
      var label = tc.name;
      if (tc.args && tc.args.query) label += '("' + tc.args.query + '")';
      else if (tc.args && tc.args.id) label += '(' + tc.args.id + ')';
      else if (tc.args && tc.args.ids) label += '([' + tc.args.ids.join(', ') + '])';
      return label;
    }

    function renderWorkflow(reportedIds) {
      var html = '<h2>Agent Workflow</h2>';
      toolHistory.forEach(function(turn, ti) {
        var isLast = ti === toolHistory.length - 1;
        html += '<div class="wf-turn' + (isLast ? ' wf-turn-last' : '') + '">';
        html += '<div class="wf-turn-label">Turn ' + turn.turn + '</div>';
        turn.calls.forEach(function(tc) {
          var icon = TOOL_ICONS[tc.name] || '';
          html += '<div class="wf-step">';
          html += '<div class="wf-step-icon">' + icon + '</div>';
          html += '<div class="wf-step-body">';
          html += '<div class="wf-step-name">' + esc(tc.name) + '</div>';
          if (tc.args && tc.args.query) {
            html += '<div class="wf-step-detail">' + esc(tc.args.query) + '</div>';
          } else if (tc.args && tc.args.id) {
            html += '<div class="wf-step-detail">ID: ' + esc(tc.args.id) + '</div>';
          } else if (tc.args && tc.args.ids) {
            html += '<div class="wf-step-detail">' + tc.args.ids.length + ' book' + (tc.args.ids.length !== 1 ? 's' : '') + ' ranked</div>';
          }
          var metaParts = [];
          if (tc.args && tc.args.limit) metaParts.push('limit: ' + tc.args.limit);
          if (tc.meta) {
            metaParts.push(tc.meta.totalHits.toLocaleString() + ' hits');
            metaParts.push(tc.meta.tookMs + 'ms');
          }
          if (metaParts.length) {
            html += '<div class="wf-step-meta">' + esc(metaParts.join(' · ')) + '</div>';
          }
          if (tc.meta && tc.meta.topIds && tc.meta.topIds.length) {
            html += '<div class="wf-step-ids">';
            tc.meta.topIds.forEach(function(id) {
              html += '<span class="wf-id-chip">' + esc(id) + '</span>';
            });
            html += '</div>';
          }
          html += '</div></div>';
        });
        html += '</div>';
      });
      // Final report step
      if (reportedIds && reportedIds.length) {
        html += '<div class="wf-turn wf-turn-last">';
        html += '<div class="wf-turn-label">Result</div>';
        html += '<div class="wf-step wf-step-final">';
        html += '<div class="wf-step-icon">' + (TOOL_ICONS.report_helpful_ids || '') + '</div>';
        html += '<div class="wf-step-body">';
        html += '<div class="wf-step-name">report_helpful_ids</div>';
        html += '<div class="wf-step-detail">' + reportedIds.length + ' book' + (reportedIds.length !== 1 ? 's' : '') + ' returned</div>';
        html += '</div></div></div>';
      }
      workflowSidebar.innerHTML = html;
    }

    function renderResults(books, elapsed) {
      if (!books || !books.length) {
        resultsArea.innerHTML = '<p class="no-results">No relevant books found.</p>';
        return;
      }
      var html = '<div class="results-header">' + books.length + ' result' + (books.length !== 1 ? 's' : '') + ' ranked by relevance in ' + elapsed + ' seconds</div>';
      books.forEach(function(book, i) {
        html += '<article class="result">';
        html += '<div class="rank">' + (i + 1) + '</div>';
        html += '<div class="thumb" aria-hidden="true"><img src="' + esc(book.img) + '"></div>';
        html += '<div class="result-body">';
        html += '<div class="meta-row">';
        book.subtitles.forEach(function(s, j) {
          if (j > 0) html += '<span class="meta-sep">&middot;</span>';
          html += '<span>' + esc(s) + '</span>';
        });
        html += '</div>';
        html += '<h3><a href="' + esc(book.link) + '">' + esc(book.title) + '</a></h3>';
        if (book.snippet) html += '<p class="snippet">' + esc(book.snippet) + '</p>';
        if (book.tags && book.tags.length) {
          html += '<div class="result-tags">';
          book.tags.forEach(function(t) { html += '<span class="tag">' + esc(t) + '</span>'; });
          html += '</div>';
        }
        html += '</div></article>';
      });
      resultsArea.innerHTML = html;
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      runQuery(input.value);
    });

    document.querySelectorAll('.example-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        runQuery(btn.getAttribute('data-query'));
      });
    });

    // If URL has a query, run it on load
    var params = new URLSearchParams(window.location.search);
    if (params.get('q')) {
      runQuery(params.get('q'));
    }
  </script>
</body>
</html>
