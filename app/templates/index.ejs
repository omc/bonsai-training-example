<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bonsai Search</title>
  <link rel="shortcut icon" type="image/x-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde604e0c417ffb_Favicon.png" />
  <link rel="apple-touch-icon" href="https://cdn.prod.website-files.com/63c81e4decde60c281417feb/63c81e4decde602edf417ffc_Webclip.png" />
  <link href="/css/fonts.css" rel="stylesheet">
  <link href="/css/index.css" rel="stylesheet">
</head>
<body>
  <div class="bg-wash" aria-hidden="true"></div>

  <main class="stage">
    <div><img src="/img/logo.svg" width="300" height="84"></div>

    <form class="search rise d2" action="/search" method="get" autocomplete="off" role="search">
      <svg class="icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="M20 20l-3.5-3.5"/>
      </svg>
      <input name="q" type="text" placeholder="Search..." aria-label="Search" spellcheck="false" />
    </form>
  </main>

  <footer class="app-footer">
    <div class="footer-row">
      <div>&copy; 2026 Bonsai</div>
      <div class="links">
        <a href="https://bonsai.io/">About</a>
        <a href="https://bonsai.io/privacy">Privacy</a>
        <a href="https://bonsai.io/terms">Terms</a>
      </div>
    </div>
  </footer>
</body>
</html>
