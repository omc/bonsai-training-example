<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Image search &mdash; Bonsai</title>
  <link href="/css/fonts.css" rel="stylesheet">
  <link href="/css/results.css" rel="stylesheet">
  <link href="/css/embed.css" rel="stylesheet">
  <% if (config.autocomplete) { %><link href="/css/autocomplete.css" rel="stylesheet"><% } %>
</head>
<body class="embed" data-results="<%= similarId ? 'similar' : 'search' %>">
  <%
    var hits = results ? (results.body.hits.hits || []) : [];
    var total = results ? results.body.hits.total : 0;
    var totalCount = (typeof total === 'object') ? total.value : total;
    var pageable = config.query.paginationDepth ? Math.min(totalCount, config.query.paginationDepth) : totalCount;
    var totalPages = Math.ceil(pageable / perPage);
    var aggs = (results && results.body.aggregations) || {};
    var base = '/embed/' + dataset;
    var f = filters || {};

    // Filters ride along on paging, and reset on a new query or example.
    function searchUrl(q, p, keepFilters) {
      var ps = new URLSearchParams({ q: q });
      if (keepFilters) {
        Object.keys(f).forEach(function(k) {
          [].concat(f[k]).forEach(function(v) { ps.append(k, v); });
        });
      }
      if (p > 1) ps.set('page', p);
      return base + '?' + ps.toString();
    }
    // Id only: carrying the query or the "back" target would give every image
    // one URL per results page it appears on, which crawlers walk endlessly.
    // js/embed-back.js restores "back to results" from the tab's history.
    function similarUrl(id, p) {
      var ps = new URLSearchParams({ id: id });
      if (p > 1) ps.set('page', p);
      return base + '?' + ps.toString();
    }
    function pageUrl(p) {
      return similarId ? similarUrl(similarId, p) : searchUrl(query, p, true);
    }
    // Tiles open the in-frame asset page when the dataset has one.
    function tileUrl(hit) {
      if (!config.asset) return similarUrl(hit._id, 1);
      return base + '/asset?' + new URLSearchParams({ id: hit._id }).toString();
    }
    var hasFilters = !similarId && results && config.aggregations && config.aggregations.length;
  %>

  <div class="embed-shell<%= config.display.justified ? ' embed-wide' : '' %>">
    <form class="search embed-search" action="<%= base %>" method="get" autocomplete="off" role="search">
      <svg class="icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/>
        <path d="M20 20l-3.5-3.5"/>
      </svg>
      <input name="q" type="text" aria-label="Describe the image you're looking for" value="<%= similarId ? '' : query %>" placeholder="Describe an image<%= indexCount ? ' — search ' + indexCount.toLocaleString() + ' assets' : '' %>..."<% if (config.autocomplete) { %> data-autocomplete="/<%= dataset %>/autocomplete" data-asset-base="<%= base %>/asset"<% } %> />
      <button type="submit" class="embed-go">Search</button>
    </form>

    <div class="embed-examples" aria-label="Example searches">
      <span class="embed-examples-label">Try:</span>
      <% examples.forEach(function(ex) { %>
      <a class="embed-chip<%= (!similarId && ex === query) ? ' active' : '' %>" rel="nofollow" href="<%= searchUrl(ex, 1, false) %>"><%= ex %></a>
      <% }); %>
    </div>

    <div class="embed-status">
      <% if (error) { %>
      <span><%= error %></span>
      <% } else if (similarId) { %>
      <span>Visually similar to <em><%= similarLabel %></em></span>
      <span class="meta-sep">&middot;</span>
      <a href="<%= base %>" rel="nofollow" data-back="search">&larr; back to results</a>
      <% } else if (results) { %>
      <span>Results for <em>&ldquo;<%= query %>&rdquo;</em></span>
      <span class="meta-sep">&middot;</span>
      <span class="embed-hint"><%= config.asset ? 'click any image for details and similar images' : 'click any image to find similar ones' %></span>
      <% } %>
    </div>

    <div class="embed-layout<%= hasFilters ? ' has-filters' : '' %>">
      <% if (hasFilters) { %>
      <%- include('_filters', {
        config: config, aggs: aggs, filters: f,
        action: base,
        hidden: { q: query },
        clearHref: searchUrl(query, 1, false),
        facetNames: config.embed.facets || null,
        bucketLimit: config.embed.facetSize || null,
        openGroups: config.embed.openFacets || null,
      }) %>
      <% } %>

      <main class="embed-results">
        <% if (results && !hits.length && !error) { %>
        <p class="embed-empty">No images found.</p>
        <% } %>

        <div class="picture-grid<%= config.display.justified ? ' justified' : '' %>">
          <% hits.forEach(function(hit) { %>
          <%- include('_result-tile', { hit: hit, src: hit._source, config: config, dataset: dataset, sourceId: similarId, tileHref: tileUrl, tileTitle: config.asset ? 'View details' : 'Find images similar to this one' }) %>
          <% }); %>
        </div>

        <% if (totalPages > 1) { %>
        <nav class="pagination embed-pager" aria-label="Result pages">
          <% if (page > 1) { %><a class="page-arrow" rel="nofollow" href="<%= pageUrl(page - 1) %>">&laquo; Prev</a><% } %>
          <span class="embed-page-of">Page <%= page %> of <%= totalPages %></span>
          <% if (page < totalPages) { %><a class="page-arrow" rel="nofollow" href="<%= pageUrl(page + 1) %>">Next &raquo;</a><% } %>
        </nav>
        <% } %>
      </main>
    </div>

<%- include('_embed-foot') %>
  </div>
  <% if (config.autocomplete) { %><script src="/js/autocomplete.js" defer></script><% } %>
  <script src="/js/embed-back.js" defer></script>
</body>
</html>
