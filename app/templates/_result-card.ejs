<article class="result"<% if (judgeEnabled) { %> data-judge-id="<%= hit._id %>"<% } %>>
  <div class="thumb" aria-hidden="true">
    <img src="<%- img %>">
  </div>
  <div>
    <div class="meta-row">
      <% config.display.subtitleFields.forEach(function(sf, i) {
        var val = sf.value(src);
        if (val) { %>
      <% if (i > 0) { %><span class="meta-sep">&middot;</span><% } %>
      <span><%= val %></span>
      <% }
      }); %>
      <% if (judgeEnabled) { %><span class="judge-badge" hidden></span><% } %>
      <% if (judged) {
        var grades = (config.judge && config.judge.grades) || []; %>
      <% if (judged.label == null) { %>
      <span class="judge-badge judge-none">not judged &middot; was #<%= judged.rank %></span>
      <% } else { %>
      <span class="judge-badge judge-g<%= judged.label %>" title="expected grade <%= judged.expected_grade.toFixed(2) %>"><%= judged.label %><%= grades[judged.label] ? ' \u00b7 ' + grades[judged.label] : '' %> &middot; was #<%= judged.rank %></span>
      <% } %>
      <% } %>
    </div>
    <h3><a href="<%= link %>"><%= title %></a></h3>
    <% if (snippet) { %>
    <p class="snippet"><%= snippet %></p>
    <% } %>
    <div class="result-tags">
      <% config.display.tags.forEach(function(tagFn) {
        var tagVal = tagFn(src);
        var tagArr = [].concat(tagVal || []).filter(function(t) { return t != null; });
        tagArr.forEach(function(t) { %>
      <span class="tag"><%= t %></span>
      <%   });
      }); %>
    </div>
  </div>
</article>