{
  "mappings": {
    "properties": {
      "title": { "type": "text", "analyzer": "analyze_title" }
    }
  },
  "settings": {
    "analysis": {
      "filter": {
        "english_stop": { "type": "stop", "stopwords": "_english_" },
        "english_stem": { "type": "stemmer", "language": "english" }
      },
      "analyzer": {
        "analyze_english": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "english_stop", "english_stem"]
        }
      }
    }
  }
}
